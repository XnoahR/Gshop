@baseUrl = http://localhost:3000
@brandId = 1
@categoryId = 1
@guitarId = 1

### Health Check
GET {{baseUrl}}/health

### ========== BRANDS ==========

### Create Brand
POST {{baseUrl}}/api/brands
Content-Type: application/json

{
  "name": "Fender"
}

### Get All Brands
GET {{baseUrl}}/api/brands

### Get Brand by ID
GET {{baseUrl}}/api/brands/{{brandId}}

### Update Brand
PUT {{baseUrl}}/api/brands/{{brandId}}
Content-Type: application/json

{
  "name": "Gibson"
}

### Delete Brand
DELETE {{baseUrl}}/api/brands/2

### ========== CATEGORIES ==========

### Create Category
POST {{baseUrl}}/api/categories
Content-Type: application/json

{
  "name": "Electric"
}

### Get All Categories
GET {{baseUrl}}/api/categories

### Get Category by ID
GET {{baseUrl}}/api/categories/{{categoryId}}

### Update Category
PUT {{baseUrl}}/api/categories/{{categoryId}}
Content-Type: application/json

{
  "name": "Acoustic"
}

### Delete Category
DELETE {{baseUrl}}/api/categories/{{categoryId}}

### ========== GUITARS ==========

### Create Guitar
POST {{baseUrl}}/api/guitars
Content-Type: application/json

{
  "name": "Stratocaster",
  "price": 25000000,
  "description": "Classic electric guitar with versatile sound",
  "stock": 10,
  "brandId": {{brandId}},
  "categoryId": {{categoryId}}
}

### Get All Guitars
GET {{baseUrl}}/api/guitars

### Get Guitar by ID
GET {{baseUrl}}/api/guitars/{{guitarId}}

### Update Guitar
PUT {{baseUrl}}/api/guitars/{{guitarId}}
Content-Type: application/json

{
  "price": 22000000,
  "stock": 15
}

### Delete Guitar
DELETE {{baseUrl}}/api/guitars/{{guitarId}}

### Reduce Stock
POST {{baseUrl}}/api/guitars/{{guitarId}}/reduce-stock
Content-Type: application/json

{
  "quantity": 2
}
